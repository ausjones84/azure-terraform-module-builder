{{ safety_warning }}
# ---------------------------------------------------------------------------
# AI Foundry (Azure AI Services) Module Deployment
# Generated by: azure-terraform-module-builder
# Status: DRAFT - Review all TODO values before use
# ---------------------------------------------------------------------------

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.80.0"
    }
  }
  required_version = ">= 1.3.0"
}

locals {
  # TODO: Update these values from your environment configuration
  resource_group_name = "{{ resource.resource_group | default('# TODO: resource group') }}"
  location            = "{{ resource.location | default('eastus') }}"
  environment         = "{{ env_path.split('/')[1] | default('dev') }}"
}

# ---------------------------------------------------------------------------
# AI Foundry (AI Services) Module
# ---------------------------------------------------------------------------
module "ai_foundry" {
  source = "{{ module_source }}"

  # Resource identity - confirmed from Azure
  name                = "{{ resource.name | default('# TODO: resource name') }}"
  resource_group_name = local.resource_group_name
  location            = local.location

  # SKU configuration
  # Confirmed SKU: {{ resource.sku_name | default('# TODO: SKU') }}
  sku_name = "{{ resource.sku_name | default('# TODO: sku_name') }}"

  # Kind: {{ resource.extras.kind | default('AIServices') }}
  kind = "{{ resource.extras.kind | default('AIServices') }}"

  # Network access
  # TODO: Confirm public network access requirement
  public_network_access_enabled = {{ 'false' if (resource.public_network_access or '').lower() == 'disabled' else '# TODO: true or false' }}

  # Custom subdomain (required for private endpoints)
  {% if resource.custom_subdomain %}
  custom_subdomain_name = "{{ resource.custom_subdomain }}"
  {% else %}
  # custom_subdomain_name = "# TODO: required for private endpoint access"
  {% endif %}

  # Identity configuration
  # TODO: Confirm identity type - SystemAssigned recommended for Foundry
  identity_type = "{{ resource.identity.type if resource.identity else 'SystemAssigned' }}"

  {% if resource.private_endpoints %}
  # Private Endpoint Configuration
  # Discovered: {{ resource.private_endpoints | length }} private endpoint(s)
  {% for pe in resource.private_endpoints %}
  # PE: {{ pe.name }}
  #   VNet:       {{ pe.vnet_name or '# TODO' }}
  #   Subnet:     {{ pe.subnet_name or '# TODO' }}
  #   Private IP: {{ pe.private_ip_address or '# TODO - WARNING: No private IP found' }}
  #   Group IDs:  {{ pe.group_ids | join(', ') or 'account' }}
  {% endfor %}
  private_endpoint_subnet_id = var.private_endpoint_subnet_id
  private_endpoint_name      = var.private_endpoint_name
  {% else %}
  # TODO: Configure private endpoint for network isolation
  # private_endpoint_subnet_id = var.private_endpoint_subnet_id
  {% endif %}

  # Diagnostic Settings
  {% if resource.diagnostic_settings %}
  # Diagnostic settings detected: {{ resource.diagnostic_settings | length }}
  log_analytics_workspace_id = var.log_analytics_workspace_id
  {% else %}
  # TODO: Configure diagnostic settings
  log_analytics_workspace_id = var.log_analytics_workspace_id
  {% endif %}

  # RBAC - Admin and developer groups
  # TODO: Provide Azure AD group object IDs
  admin_group_object_id     = var.admin_group_object_id
  developer_group_object_id = var.developer_group_object_id

  # Tags
  {% if resource.tags %}
  tags = {
    {% for k, v in resource.tags.items() %}
    {{ k }} = "{{ v }}"
    {% endfor %}
  }
  {% else %}
  tags = var.tags # TODO: Define required tags
  {% endif %}
}

# ---------------------------------------------------------------------------
# IMPORTANT: Import commands
# ---------------------------------------------------------------------------
# If this resource already exists in Azure, import BEFORE terraform apply:
#
# terraform import 'module.ai_foundry.azurerm_cognitive_account.this' '{{ resource.resource_id or "# TODO: resource ID" }}'
#
# See import_commands.sh for the full import sequence.
# DO NOT run terraform apply without importing first if resource exists.

# Outputs
output "ai_foundry_id" {
  value       = module.ai_foundry.id
  description = "AI Foundry resource ID"
}

output "ai_foundry_endpoint" {
  value       = module.ai_foundry.endpoint
  description = "AI Foundry endpoint URL"
}

output "ai_foundry_principal_id" {
  value       = module.ai_foundry.principal_id
  description = "Managed identity principal ID for RBAC assignments"
}
