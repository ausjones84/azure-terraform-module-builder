{{ safety_warning }}
# ---------------------------------------------------------------------------
# RBAC Role Assignment Module Deployment
# Generated by: azure-terraform-module-builder
# Status: DRAFT - Review all TODO values before use
# ---------------------------------------------------------------------------
# WARNING: RBAC changes grant or modify access to Azure resources.
# ALL role assignments must be reviewed and approved before apply.
# Principle of least privilege: use the minimum required role.
# ---------------------------------------------------------------------------

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.80.0"
    }
  }
  required_version = ">= 1.3.0"
}

locals {
  # Scope: the resource these RBAC assignments apply to
  resource_scope = "{{ resource.resource_id | default('# TODO: resource ID as scope') }}"
}

# ---------------------------------------------------------------------------
# Role Assignments - discovered from Azure
# ---------------------------------------------------------------------------
{% if resource.role_assignments %}
# Found {{ resource.role_assignments | length }} existing role assignment(s) on this resource.
# Recreate below as needed. Verify principal_id values before apply.
{% for ra in resource.role_assignments %}
# --- Role Assignment {{ loop.index }}: {{ ra.role_definition_name }} ---
# Principal Type: {{ ra.principal_type }}
# Principal ID:   {{ ra.principal_id }}  # TODO: Verify this is the correct principal
# Scope:          {{ ra.scope }}
resource "azurerm_role_assignment" "ra_{{ loop.index }}" {
  scope                = local.resource_scope
  role_definition_name = "{{ ra.role_definition_name }}"
  principal_id         = "{{ ra.principal_id }}"  # TODO: Verify principal ID
}

{% endfor %}
{% else %}
# No existing role assignments discovered.
# TODO: Define required role assignments below.

# Example - Cognitive Services User role for managed identity:
# resource "azurerm_role_assignment" "ai_search_reader" {
#   scope                = local.resource_scope
#   role_definition_name = "Search Index Data Reader"
#   principal_id         = var.app_service_principal_id  # TODO: principal ID
# }

# Example - Admin group assignment:
resource "azurerm_role_assignment" "admin" {
  scope                = local.resource_scope
  role_definition_name = "# TODO: role name (e.g. Contributor, Reader)"
  principal_id         = var.admin_group_object_id  # TODO: admin group object ID
}

resource "azurerm_role_assignment" "developer" {
  scope                = local.resource_scope
  role_definition_name = "# TODO: role name (e.g. Search Index Data Reader)"
  principal_id         = var.developer_group_object_id  # TODO: dev group object ID
}
{% endif %}

# ---------------------------------------------------------------------------
# IMPORTANT: Import commands
# ---------------------------------------------------------------------------
# Existing role assignments must be imported before apply.
# Format: terraform import 'azurerm_role_assignment.ra_1' '<scope>/providers/Microsoft.Authorization/roleAssignments/<uuid>'
#
# Find assignment IDs:
#   az role assignment list --scope "{{ resource.resource_id | default('SCOPE') }}" --output table
#
# See import_commands.sh for full import sequence.

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------
variable "admin_group_object_id" {
  description = "TODO: Azure AD group object ID for admin access"
  type        = string
}

variable "developer_group_object_id" {
  description = "TODO: Azure AD group object ID for developer access"
  type        = string
}

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
{% if resource.role_assignments %}
{% for ra in resource.role_assignments %}
output "role_assignment_{{ loop.index }}_id" {
  value       = azurerm_role_assignment.ra_{{ loop.index }}.id
  description = "Role assignment {{ loop.index }} ({{ ra.role_definition_name }}) resource ID"
}
{% endfor %}
{% else %}
output "admin_role_assignment_id" {
  value       = azurerm_role_assignment.admin.id
  description = "Admin role assignment ID"
}
{% endif %}
