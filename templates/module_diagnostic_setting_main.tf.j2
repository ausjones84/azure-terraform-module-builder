{{ safety_warning }}
# ---------------------------------------------------------------------------
# Diagnostic Settings Module Deployment
# Generated by: azure-terraform-module-builder
# Status: DRAFT - Review all TODO values before use
# ---------------------------------------------------------------------------
# NOTE: Diagnostic settings attach to an existing resource.
# The target_resource_id must reference the resource you want to monitor.
# ---------------------------------------------------------------------------

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.80.0"
    }
  }
  required_version = ">= 1.3.0"
}

locals {
  # TODO: Set to the resource ID of the Azure resource to monitor
  target_resource_id = "{{ resource.resource_id | default('# TODO: target resource ID') }}"
}

# ---------------------------------------------------------------------------
# Diagnostic Settings
# ---------------------------------------------------------------------------
resource "azurerm_monitor_diagnostic_setting" "this" {
  name               = "{{ resource.name | default('diag') }}-diag"
  target_resource_id = local.target_resource_id

  # Log Analytics Workspace destination
  # TODO: Provide the Log Analytics workspace resource ID
  log_analytics_workspace_id = var.log_analytics_workspace_id

  {% if resource.diagnostic_settings and resource.diagnostic_settings[0].log_categories %}
  # Log categories - discovered from Azure
  {% for category in resource.diagnostic_settings[0].log_categories %}
  enabled_log {
    category = "{{ category }}"
  }
  {% endfor %}
  {% else %}
  # TODO: Add the appropriate log categories for this resource type.
  # Common categories for AI Search: OperationLogs
  # Common categories for Cognitive Services: Audit, RequestResponse, Trace
  enabled_log {
    category = "# TODO: log category name"
  }
  {% endif %}

  {% if resource.diagnostic_settings and resource.diagnostic_settings[0].metric_categories %}
  # Metric categories - discovered from Azure
  {% for category in resource.diagnostic_settings[0].metric_categories %}
  metric {
    category = "{{ category }}"
    enabled  = true
  }
  {% endfor %}
  {% else %}
  # TODO: Add metric categories if required
  # metric {
  #   category = "AllMetrics"
  #   enabled  = true
  # }
  {% endif %}
}

# ---------------------------------------------------------------------------
# IMPORTANT: Import commands
# ---------------------------------------------------------------------------
# If this diagnostic setting already exists in Azure:
#
# terraform import 'azurerm_monitor_diagnostic_setting.this' \
#   '{{ resource.resource_id or "# TODO" }}|{{ resource.name or "TODO" }}-diag'
#
# See import_commands.sh for full import sequence.

# Variables
variable "log_analytics_workspace_id" {
  description = "Log Analytics Workspace resource ID for diagnostic settings"
  type        = string
}

# Outputs
output "diagnostic_setting_id" {
  value       = azurerm_monitor_diagnostic_setting.this.id
  description = "Diagnostic setting resource ID"
}
